{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Poetry: Run Current File",
            "type": "python",
            "request": "launch",
            "module": "poetry.cli.main",
            "args": [
                "run",
                "python",
                "${file}"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
